# --- Staging access protection ----------------------------------------------
# "user:password" puts every page behind HTTP Basic Auth. Recommended for any
# staging/preview host reachable from the internet. Leave empty in production.
STAGING_BASIC_AUTH=

# --- Contact form (Resend) ---------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=

# --- Social profiles (footer) -------------------------------------------------
# Full profile URLs. Empty = the default numerosemanas handle in Footer.tsx.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_BLUESKY=

# --- Consent-based analytics -----------------------------------------------
# Both integrations load only after the visitor accepts analytics cookies.
# GA4 expects an ID such as G-XXXXXXXXXX; Clarity expects its project ID.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
